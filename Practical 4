#include <stdio.h>
#define MAX 5
int deque[MAX];
int front = -1;
int rear = -1;
// Insert element at front
void insertFront(int value)
{
    if ((front == 0 && rear == MAX - 1) || (front == rear + 1))
    {
        printf("Deque is Full!\n");
    }
    else if (front == -1)
    {
        front = rear = 0;
        deque[front] = value;
        printf("%d inserted into deque from front.\n", value);
    }
    else if (front == 0)
    {
        front = MAX - 1;
        deque[front] = value;
        printf("%d inserted into deque from front.\n", value);
    }
    else
    {
        front--;
        deque[front] = value;
        printf("%d inserted into deque from front.\n", value);
    }
}
// Insert element at rear
void insertRear(int value)
{
    if ((front == 0 && rear == MAX - 1) || (front == rear + 1))
    {
        printf("Deque is Full!\n");
    }
    else if (front == -1)
    {
        front = rear = 0;
        deque[rear] = value;
        printf("%d inserted into deque from rear.\n", value);
    }
    else if (rear == MAX - 1)
    {
        rear = 0;
        deque[rear] = value;
        printf("%d inserted into deque from rear.\n", value);
    }
    else
    {
        rear++;
        deque[rear] = value;
        printf("%d inserted into deque from rear.\n", value);
    }
}
// Delete element from front
void deleteFront()
{
    if (front == -1)
    {
        printf("Deque is Empty!\n");
    }
    else if (front == rear)
    {
        printf("%d deleted from deque from front.\n", deque[front]);
        front = rear = -1;
    }
    else if (front == MAX - 1)
    {
        printf("%d deleted from deque from front.\n", deque[front]);
        front = 0;
    }
    else
    {
        printf("%d deleted from deque from front.\n", deque[front]);
        front++;
    }
}
// Delete element from rear
void deleteRear()
{
    if (front == -1)
    {
        printf("Deque is Empty!\n");
    }
    else if (front == rear)
    {
        printf("%d deleted from deque from rear.\n", deque[rear]);
        front = rear = -1;
    }
    else if (rear == 0)
    {
        printf("%d deleted from deque from rear.\n", deque[rear]);
        rear = MAX - 1;
    }
    else
    {
        printf("%d deleted from deque from rear.\n", deque[rear]);
        rear--;
    }
}
